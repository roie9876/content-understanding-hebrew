# Copy this file to `.env` and replace every placeholder.
# `.env` is ignored by Git. Never commit real resource names, endpoints, or keys.
# Authentication uses Microsoft Entra ID (Azure CLI); run `az login` first.

# --- Azure AI Content Understanding ---
CU_ENDPOINT=https://<content-understanding-resource>.cognitiveservices.azure.com/
CU_API_VERSION=2025-11-01
CU_ANALYZER_ID=<analyzer-id>

# --- Azure OpenAI GPT vision ---
GPT_ENDPOINT=https://<primary-foundry-resource>.services.ai.azure.com/openai/v1/
GPT_DEPLOYMENT=gpt-5.4
# Minimum confidence for accepting a non-empty contextual reread that changes the visual result.
CONTEXTUAL_RECHECK_MIN_CONFIDENCE=0.60
# JSON array used for round-robin balancing and transient failover.
GPT_TARGETS=[{"name":"primary","endpoint":"https://<primary-foundry-resource>.services.ai.azure.com/openai/v1/","deployment":"gpt-5.4"},{"name":"secondary","endpoint":"https://<secondary-foundry-resource>.services.ai.azure.com/openai/v1/responses","deployment":"gpt-5.4"}]

# Optional model profiles shown by the UI.
GPT_PRO_ENDPOINT=https://<foundry-resource>.services.ai.azure.com/openai/v1/
GPT_PRO_DEPLOYMENT=gpt-5.4-pro
GPT_LUNA_ENDPOINT=https://<foundry-resource>.services.ai.azure.com/openai/v1/
GPT_LUNA_DEPLOYMENT=gpt-5.6-luna
GPT_SOL_ENDPOINT=https://<foundry-resource>.services.ai.azure.com/openai/v1/
GPT_SOL_DEPLOYMENT=gpt-5.6-sol

# The customer-facing UI defaults to GPT-5.4 with standard Core4 reconciliation.

# --- Optional local Ivrit OCR / HASH v1 advisory sidecar ---
# Start https://github.com/roie9876/heb-handfree natively or with Docker on port 8000.
# The pipeline checks /health once per page and continues normally when unavailable.
IVRIT_OCR_ENABLED=1
IVRIT_OCR_URL=http://127.0.0.1:8000
IVRIT_OCR_TIMEOUT=60
# The HASH service serializes model inference, so one caller worker is the safe default.
IVRIT_OCR_WORKERS=1
# Minimum normalized Hebrew character agreement with Core4 before GPT sees HASH text.
IVRIT_OCR_MIN_AGREEMENT=0.40
# Minimum agreement between original and blue-only HASH reads for duplicate-line recovery.
IVRIT_OCR_MIN_PREPROCESS_AGREEMENT=0.55

# Optional GitHub identity whose Copilot catalog includes Claude Opus 4.8.
# The app obtains a short-lived process token with `gh auth token --user`; no token is stored here.
COPILOT_GITHUB_USER=<github-login>

# Optional Document Intelligence benchmark.
DI_ENDPOINT=https://<document-intelligence-resource>.cognitiveservices.azure.com/

# --- Rendering / output ---
RENDER_DPI=220
OUT_DIR=out

# Uncomment to run Content Understanding only (skip GPT vision):
# SKIP_GPT=1
