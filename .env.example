# Copy this file to `.env` and adjust values, or export these as shell variables.
# Authentication uses Microsoft Entra ID (Azure CLI) — run `az login` first.
# The script also has these same values baked in as defaults.

# --- Azure AI Content Understanding (Entra ID auth; local keys are disabled) ---
CU_ENDPOINT=https://ai-content-understanding-resource-2416.cognitiveservices.azure.com/
CU_API_VERSION=2025-11-01
CU_ANALYZER_ID=hebrewHandoverForm

# --- Azure OpenAI GPT vision (v1 Responses API) ---
GPT_ENDPOINT=https://medical-summary.services.ai.azure.com/openai/v1/
GPT_DEPLOYMENT=gpt-5.4

# GPT-5.6 Luna alternative:
# GPT_ENDPOINT=https://admin-9107-resource.services.ai.azure.com/openai/v1/
# GPT_DEPLOYMENT=gpt-5.6-luna

# GPT-5.6 Sol alternative:
# GPT_ENDPOINT=https://admin-9107-resource.services.ai.azure.com/openai/v1/
# GPT_DEPLOYMENT=gpt-5.6-sol

# --- Rendering / output ---
RENDER_DPI=220
OUT_DIR=out

# Uncomment to run Content Understanding only (skip GPT vision):
# SKIP_GPT=1
